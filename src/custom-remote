#include <WiFi.h>
#include <WiFiUdp.h>

// ======= KONFIGURASI ========
// WiFi
const char* ssid = "RobotTransporter";
const char* password = "transporter123";
const IPAddress robotIP(192, 168, 4, 1); // ESP32 robot berperan sebagai AP dengan IP default
const int udpPort = 4210;

// PIN untuk tombol dan joystick
#define btngreen 25  // Toggle gripper open/close
#define btngrey 32   // Toggle lift up/down
#define btnbrown 34  // Toggle speed high/low
#define vrx 5        // Joystick X axis
#define vry 18       // Joystick Y axis
#define switch_btn 19 // Switch button pada joystick

// ======= VARIABEL GLOBAL ========
// Variabel untuk status
int xValue, yValue;
bool btnGreenState = false, btnGreyState = false, btnBrownState = false, switchState = false;
bool lastBtnGreenState = false, lastBtnGreyState = false, lastBtnBrownState = false, lastSwitchState = false;
bool isGripperOpen = false;  // Status gripper
bool isLiftUp = false;       // Status lift
bool isHighSpeed = true;     // Status kecepatan
int gripperMode = 0;         // 0 = open&down, 1 = close&up

// Network
WiFiUDP udp;
unsigned long lastDataSent = 0;
const int sendInterval = 20;  // 50Hz update rate
unsigned long lastConnectCheck = 0;
unsigned long packetCount = 0;
bool showStatus = false;

// ======= SETUP ========
void setup() {
  Serial.begin(115200);
  Serial.println("\n==================================================");
  Serial.println("      ROBOT TRANSPORTER - REMOTE CONTROLLER");
  Serial.println("==================================================");
  
  // Setup pin
  pinMode(btngreen, INPUT_PULLUP);
  pinMode(btngrey, INPUT_PULLUP);
  pinMode(btnbrown, INPUT_PULLUP);
  pinMode(switch_btn, INPUT_PULLUP);
  
  // Setup WiFi (STA mode)
  connectToRobot();
  
  Serial.println("Remote controller ready!");
  Serial.println("==================================================");
}

// ======= FUNCTIONS ========
void connectToRobot() {
  Serial.println("Connecting to robot WiFi network...");
  WiFi.mode(WIFI_STA);
  WiFi.begin(ssid, password);
  
  int attempts = 0;
  while (WiFi.status() != WL_CONNECTED && attempts < 20) {
    delay(500);
    Serial.print(".");
    attempts++;
  }
  
  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("\nConnected to robot!");
    Serial.print("IP Address: ");
    Serial.println(WiFi.localIP());
    
    // Start UDP
    udp.begin(udpPort);
    Serial.println("UDP initialized on port " + String(udpPort));
  } else {
    Serial.println("\nFailed to connect! Will retry in loop...");
  }
}

void checkConnection() {
  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("WiFi connection lost! Reconnecting...");
    WiFi.disconnect();
    delay(1000);
    connectToRobot();
  }
}

void sendControlData() {
  if (WiFi.status() != WL_CONNECTED) {
    return;
  }
  
  // Create packet with format: "X,Y,GripperState,LiftState,SpeedState,GripperMode"
  // Add toggle flags to detect new presses
  String dataPacket = String(xValue) + "," + 
                     String(yValue) + "," +
                     String(btnGreenState != lastBtnGreenState && btnGreenState) + "," + // Green toggle
                     String(btnGreyState != lastBtnGreyState && btnGreyState) + "," +    // Grey toggle
                     String(btnBrownState != lastBtnBrownState && btnBrownState) + "," + // Brown toggle
                     String(switchState != lastSwitchState && switchState) + "," +       // Switch toggle
                     String(isGripperOpen) + "," +  // Current gripper state
                     String(isLiftUp) + "," +       // Current lift state
                     String(isHighSpeed) + "," +    // Current speed state
                     String(gripperMode);           // Current gripper mode
  
  // Send packet
  udp.beginPacket(robotIP, udpPort);
  udp.print(dataPacket);
  udp.endPacket();
  
  // Update last states
  lastBtnGreenState = btnGreenState;
  lastBtnGreyState = btnGreyState;
  lastBtnBrownState = btnBrownState;
  lastSwitchState = switchState;
  
  packetCount++;
  
  // Show debug info
  if (showStatus) {
    Serial.println("PACKET SENT: " + dataPacket);
    Serial.println("Joystick: X=" + String(xValue) + ", Y=" + String(yValue));
    Serial.println("Buttons: Green=" + String(btnGreenState?"PRESSED":"RELEASED") + 
                  ", Grey=" + String(btnGreyState?"PRESSED":"RELEASED") + 
                  ", Brown=" + String(btnBrownState?"PRESSED":"RELEASED"));
    Serial.println("States: Gripper=" + String(isGripperOpen?"OPEN":"CLOSED") + 
                  ", Lift=" + String(isLiftUp?"UP":"DOWN") + 
                  ", Speed=" + String(isHighSpeed?"HIGH":"LOW"));
    showStatus = false;
  }
}

void readInputs() {
  // Read joystick (with deadzone)
  int rawX = analogRead(vrx);
  int rawY = analogRead(vry);
  
  // Map analog values (0-4095) to control values (-100 to 100)
  xValue = map(rawX, 0, 4095, -100, 100);
  yValue = map(rawY, 0, 4095, -100, 100);
  
  // Apply deadzone
  if (abs(xValue) < 15) xValue = 0;
  if (abs(yValue) < 15) yValue = 0;
  
  // Read buttons (active low due to INPUT_PULLUP)
  btnGreenState = !digitalRead(btngreen);
  btnGreyState = !digitalRead(btngrey);
  btnBrownState = !digitalRead(btnbrown);
  switchState = !digitalRead(switch_btn);
  
  // Process button logic
  
  // Green button: Toggle gripper
  if (btnGreenState && !lastBtnGreenState) {
    isGripperOpen = !isGripperOpen;
    Serial.println("GRIPPER TOGGLE: " + String(isGripperOpen ? "OPEN" : "CLOSED"));
    showStatus = true;
  }
  
  // Grey button: Toggle lift
  if (btnGreyState && !lastBtnGreyState) {
    isLiftUp = !isLiftUp;
    Serial.println("LIFT TOGGLE: " + String(isLiftUp ? "UP" : "DOWN"));
    showStatus = true;
  }
  
  // Brown button: Toggle speed
  if (btnBrownState && !lastBtnBrownState) {
    isHighSpeed = !isHighSpeed;
    Serial.println("SPEED TOGGLE: " + String(isHighSpeed ? "HIGH" : "LOW"));
    showStatus = true;
  }
  
  // Switch button: Toggle gripper mode
  if (switchState && !lastSwitchState) {
    gripperMode = (gripperMode == 0) ? 1 : 0;
    Serial.println("GRIPPER MODE: " + String(gripperMode == 0 ? "OPEN & DOWN" : "CLOSE & UP"));
    
    // Update states based on mode
    if (gripperMode == 0) {
      isGripperOpen = true;
      isLiftUp = false;
    } else {
      isGripperOpen = false;
      isLiftUp = true;
    }
    
    showStatus = true;
  }
}

// ======= MAIN LOOP ========
void loop() {
  unsigned long currentTime = millis();
  
  // Check connection every 5 seconds
  if (currentTime - lastConnectCheck > 5000) {
    checkConnection();
    lastConnectCheck = currentTime;
  }
  
  // Read all inputs
  readInputs();
  
  // Send control data at fixed interval (50Hz)
  if (currentTime - lastDataSent >= sendInterval) {
    sendControlData();
    lastDataSent = currentTime;
  }
  
  // Print status every 3 seconds
  if (currentTime % 3000 < 10 && WiFi.status() == WL_CONNECTED) {
    Serial.println("\n--- REMOTE STATUS ---");
    Serial.println("WiFi: " + String(WiFi.status() == WL_CONNECTED ? "CONNECTED" : "DISCONNECTED"));
    Serial.println("Packets sent: " + String(packetCount));
    Serial.println("Signal strength: " + String(WiFi.RSSI()) + " dBm");
    Serial.println("---------------------");
  }
  
  delay(5); // Slight delay for stability
}

