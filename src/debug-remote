String motorSpeedToString(int speed) {
  String direction = (speed > 0) ? "FORWARD" : ((speed < 0) ? "REVERSE" : "STOP");
  int percentage = map(abs(speed), 0, 255, 0, 100);
  return direction + " " + String(percentage) + "%";
}

