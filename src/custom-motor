#include <WiFi.h>
#include <WiFiUdp.h>
#include <ESP32Servo.h>


// ======= KONFIGURASI ========
// WiFi
const char* ssid = "RobotTransporter";
const char* password = "transporter123";
const int udpPort = 4210;


// PIN untuk motor
const int enableRightMotor = 32;
const int rightMotorPin1 = 25;
const int rightMotorPin2 = 33;
const int enableLeftMotor = 14;
const int leftMotorPin1 = 27;
const int leftMotorPin2 = 26;


// PIN untuk servo, tertukar atau enggak belum dicek lagi
const int servoGripperPin = 18;  // Gripper servo
const int servoLiftPin = 19;      // Lift servo


// Konstanta motor
#define MAX_MOTOR_SPEED 255
#define SLOW_MOTOR_SPEED 150
const int PWM_FREQ = 1000;
const int PWM_RESOLUTION = 8;


// Konstanta servo
#define GRIPPER_OPEN 115
#define GRIPPER_CLOSED 55
#define LIFT_UP 45
#define LIFT_DOWN 145
#define SERVO_DELAY 15


// ======= VARIABEL GLOBAL ========
// Servo objects
Servo servoGripper;
Servo servoLift;


// Status gripper & lift
bool isGripperOpen = false;
bool isLiftUp = false;
bool isHighSpeed = true;
int currentSpeed = MAX_MOTOR_SPEED;
int gripperMode = 0;  // 0=open&down, 1=close&up


// Posisi servo
int gripperPosition = GRIPPER_CLOSED;
int liftPosition = LIFT_UP;


// Network
WiFiUDP udp;
char packetBuffer[255];
unsigned long lastPacketTime = 0;
unsigned long packetCount = 0;
unsigned long lastStatusTime = 0;
bool isConnected = false;


// ======= SETUP ========
void setup() {
  Serial.begin(115200);
  Serial.println("\n==================================================");
  Serial.println("        ROBOT TRANSPORTER - ROBOT CONTROLLER");
  Serial.println("==================================================");
 
  // Setup pins
  setupMotors();
  setupServos();
 
  // Setup WiFi (AP mode)
  setupWiFi();
 
  Serial.println("Robot controller ready!");
  Serial.println("==================================================");
 
  // Stop motors & set servos to default position
  stopMotors();
  moveServoSlowly(servoGripper, gripperPosition, gripperPosition);
  moveServoSlowly(servoLift, liftPosition, liftPosition);
}


// ======= FUNCTIONS ========
void setupMotors() {
  Serial.println("Setting up motor pins...");
 
  // Set pin modes for all motor pins
  pinMode(enableRightMotor, OUTPUT);
  pinMode(rightMotorPin1, OUTPUT);
  pinMode(rightMotorPin2, OUTPUT);
  pinMode(enableLeftMotor, OUTPUT);
  pinMode(leftMotorPin1, OUTPUT);
  pinMode(leftMotorPin2, OUTPUT);
 
  // Initialize enable pins to LOW (motors off)
  digitalWrite(enableRightMotor, LOW);
  digitalWrite(enableLeftMotor, LOW);
 
  Serial.println("Motors initialized");
}


void setupServos() {
  Serial.println("Setting up servos...");
 
  // Allocate PWM timers
  ESP32PWM::allocateTimer(0);
  ESP32PWM::allocateTimer(1);
  ESP32PWM::allocateTimer(2);
  ESP32PWM::allocateTimer(3);
 
  // Configure servos
  servoGripper.setPeriodHertz(50);
  servoLift.setPeriodHertz(50);
  servoGripper.attach(servoGripperPin, 500, 2400);
  servoLift.attach(servoLiftPin, 500, 2400);
 
  // Set initial positions
  servoGripper.write(GRIPPER_CLOSED);
  servoLift.write(LIFT_UP);
  gripperPosition = GRIPPER_CLOSED;
  liftPosition = LIFT_UP;
 
  Serial.println("Servos initialized");
}


void setupWiFi() {
  Serial.println("Setting up WiFi Access Point...");
 
  WiFi.mode(WIFI_AP);
  WiFi.softAP(ssid, password);
 
  Serial.print("AP IP address: ");
  Serial.println(WiFi.softAPIP());
 
  Serial.println("Starting UDP server on port " + String(udpPort));
  udp.begin(udpPort);
}


void stopMotors() {
  digitalWrite(rightMotorPin1, LOW);
  digitalWrite(rightMotorPin2, LOW);
  digitalWrite(leftMotorPin1, LOW);
  digitalWrite(leftMotorPin2, LOW);
  digitalWrite(enableRightMotor, LOW);  // Just turn off enable pins
  digitalWrite(enableLeftMotor, LOW);
}


void moveServoSlowly(Servo &servo, int startPos, int endPos) {
  if (startPos == endPos) {
    servo.write(endPos);
    return;
  }
 
  int step = (startPos < endPos) ? 4 : -4;
 
  for (int pos = startPos; (step > 0) ? pos <= endPos : pos >= endPos; pos += step) {
    servo.write(pos);
    delay(SERVO_DELAY);
  }
}


// Software PWM implementation for motor speed control
void setMotorSpeed(int pin, int speed) {
  // Convert speed (0-255) to on-off duty cycle
  if (speed == 0) {
    digitalWrite(pin, LOW);
  } else if (speed >= 255) {
    digitalWrite(pin, HIGH);
  } else {
    // For intermediate speeds, we'll use simple on/off control
    // Higher speed values will keep the enable pin HIGH for longer time
    digitalWrite(pin, HIGH);
  }
}


void rotateMotor(int rightSpeed, int leftSpeed) {
  // Apply speed setting
  if (!isHighSpeed) {
    rightSpeed = map(rightSpeed, -100, 100, -SLOW_MOTOR_SPEED, SLOW_MOTOR_SPEED);
    leftSpeed = map(leftSpeed, -100, 100, -SLOW_MOTOR_SPEED, SLOW_MOTOR_SPEED);
  } else {
    rightSpeed = map(rightSpeed, -100, 100, -MAX_MOTOR_SPEED, MAX_MOTOR_SPEED);
    leftSpeed = map(leftSpeed, -100, 100, -MAX_MOTOR_SPEED, MAX_MOTOR_SPEED);
  }
 
  // Control right motor
  if (rightSpeed > 0) {
    digitalWrite(rightMotorPin1, HIGH);
    digitalWrite(rightMotorPin2, LOW);
    digitalWrite(enableRightMotor, HIGH); // Full speed for now
  } else if (rightSpeed < 0) {
    digitalWrite(rightMotorPin1, LOW);
    digitalWrite(rightMotorPin2, HIGH);
    digitalWrite(enableRightMotor, HIGH); // Full speed for now
  } else {
    digitalWrite(rightMotorPin1, LOW);
    digitalWrite(rightMotorPin2, LOW);
    digitalWrite(enableRightMotor, LOW); // Stop motor
  }
 
  // Control left motor
  if (leftSpeed > 0) {
    digitalWrite(leftMotorPin1, HIGH);
    digitalWrite(leftMotorPin2, LOW);
    digitalWrite(enableLeftMotor, HIGH); // Full speed for now
  } else if (leftSpeed < 0) {
    digitalWrite(leftMotorPin1, LOW);
    digitalWrite(leftMotorPin2, HIGH);
    digitalWrite(enableLeftMotor, HIGH); // Full speed for now
  } else {
    digitalWrite(leftMotorPin1, LOW);
    digitalWrite(leftMotorPin2, LOW);
    digitalWrite(enableLeftMotor, LOW); // Stop motor
  }
 
  // Print motor speeds for debugging
  if (rightSpeed != 0 || leftSpeed != 0) {
    Serial.println("Motor Speeds - Right: " + String(rightSpeed) + ", Left: " + String(leftSpeed));
  }
}


void toggleGripper(bool openGripper) {
  int targetPosition = openGripper ? GRIPPER_OPEN : GRIPPER_CLOSED;
  moveServoSlowly(servoGripper, gripperPosition, targetPosition);
  gripperPosition = targetPosition;
  isGripperOpen = openGripper;
 
  Serial.println("Gripper: " + String(isGripperOpen ? "OPEN" : "CLOSED"));
}


void toggleLift(bool liftUp) {
  int targetPosition = liftUp ? LIFT_UP : LIFT_DOWN;
  moveServoSlowly(servoLift, liftPosition, targetPosition);
  liftPosition = targetPosition;
  isLiftUp = liftUp;
 
  Serial.println("Lift: " + String(isLiftUp ? "UP" : "DOWN"));
}


void processPacket(String data) {
  // Parse data: "X,Y,GreenToggle,GreyToggle,BrownToggle,SwitchToggle,GripperState,LiftState,SpeedState,GripperMode"
  int values[10];
  int lastComma = -1;
  int nextComma = 0;
 
  for (int i = 0; i < 10; i++) {
    nextComma = data.indexOf(',', lastComma + 1);
    if (nextComma == -1) {
      // Last value
      values[i] = data.substring(lastComma + 1).toInt();
      break;
    } else {
      values[i] = data.substring(lastComma + 1, nextComma).toInt();
      lastComma = nextComma;
    }
  }
 
  // Extract values
  int xValue = values[0];
  int yValue = values[1];
  bool greenToggle = values[2] == 1;
  bool greyToggle = values[3] == 1;
  bool brownToggle = values[4] == 1;
  bool switchToggle = values[5] == 1;
  bool remoteGripperState = values[6] == 1;
  bool remoteLiftState = values[7] == 1;
  bool remoteSpeedState = values[8] == 1;
  int remoteGripperMode = values[9];
 
  // Process movement
  rotateMotor(xValue, yValue);
 
  // Process toggles
  if (greenToggle) {
    toggleGripper(!isGripperOpen); // Toggle gripper state
  }
 
  if (greyToggle) {
    toggleLift(!isLiftUp); // Toggle lift state
  }
 
  if (brownToggle) {
    isHighSpeed = !isHighSpeed;
    Serial.println("Speed mode: " + String(isHighSpeed ? "HIGH" : "LOW"));
  }
 
  if (switchToggle) {
    gripperMode = remoteGripperMode;
   
    if (gripperMode == 0) {
      // Open gripper and lower it
      toggleGripper(true);
      toggleLift(false);
      Serial.println("SEQUENCE: Open gripper and lower");
    } else {
      // Close gripper and lift it
      toggleGripper(false);
      toggleLift(true);
      Serial.println("SEQUENCE: Close gripper and lift");
    }
  }
}


// ======= MAIN LOOP ========
void loop() {
  unsigned long currentTime = millis();
 
  // Check for UDP packets
  int packetSize = udp.parsePacket();
 
  if (packetSize) {
    // Receive packet
    int len = udp.read(packetBuffer, 255);
    if (len > 0) {
      packetBuffer[len] = 0;
      String dataString = String(packetBuffer);
     
      // Process the data
      processPacket(dataString);
     
      lastPacketTime = currentTime;
      packetCount++;
      isConnected = true;
    }
  }
 
  // Safety: stop motors if no command received in 500ms
  if (currentTime - lastPacketTime > 500 && isConnected) {
    stopMotors();
    Serial.println("CONNECTION LOST: No data received for 500ms. Motors stopped.");
    isConnected = false;
  }
 
  // Print status every 3 seconds
  if (currentTime - lastStatusTime > 3000) {
    Serial.println("\n--- ROBOT STATUS ---");
    Serial.println("Time: " + String(currentTime / 1000) + " seconds");
    Serial.println("Connected stations: " + String(WiFi.softAPgetStationNum()));
    Serial.println("Packets received: " + String(packetCount));
    Serial.println("Last packet: " + String((currentTime - lastPacketTime) / 1000.0, 1) + " sec ago");
   
    Serial.println("- Gripper: " + String(isGripperOpen ? "OPEN" : "CLOSED"));
    Serial.println("- Lift: " + String(isLiftUp ? "UP" : "DOWN"));
    Serial.println("- Speed: " + String(isHighSpeed ? "HIGH" : "LOW"));
    Serial.println("---------------------");
   
    lastStatusTime = currentTime;
  }
 
  delay(10);
}

